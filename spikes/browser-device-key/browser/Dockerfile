# Browser matrix of the E22 spike, run headless: the official Playwright image (system libraries
# and Node) with stock browser builds added, so the results are about Chrome for Testing and
# Firefox as released, not about Playwright's patched builds. Every download is checked against a pinned SHA-256:
# - Chrome for Testing 155.0.8059.84 (current stable major on 2026-10-16) and 154.0.8037.92 (the
#   last 154 build published for testing; stable 154 ended at 154.0.8037.97). Google publishes no
#   checksum for these archives: the hashes were taken at first download on 2026-10-16, so they
#   pin what was downloaded then (trust on first use), not what Google published. Chrome for
#   Testing has no field trials (variations), unlike a user's Chrome.
# - Firefox 158.0 (current release) and 157.0 (previous), hashes from Mozilla's SHA256SUMS.
ARG BASE

FROM ${BASE} AS fetch
RUN apt-get update && apt-get install --yes --no-install-recommends unzip xz-utils
WORKDIR /fetch
RUN curl -fsSL -o chrome-155.zip https://storage.googleapis.com/chrome-for-testing-public/155.0.8059.84/linux64/chrome-linux64.zip \
 && curl -fsSL -o chrome-154.zip https://storage.googleapis.com/chrome-for-testing-public/154.0.8037.92/linux64/chrome-linux64.zip \
 && curl -fsSL -o firefox-158.tar.xz https://archive.mozilla.org/pub/firefox/releases/158.0/linux-x86_64/en-US/firefox-158.0.tar.xz \
 && curl -fsSL -o firefox-157.tar.xz https://archive.mozilla.org/pub/firefox/releases/157.0/linux-x86_64/en-US/firefox-157.0.tar.xz \
 && printf '%s\n' \
    'cf0f049892dea22e6a6db26d47ed0d7776b7158edcbec4634086633df8bafcbc  chrome-155.zip' \
    'ff43322f335e436b2f4dcdfeeec5db032299e335a7e8c1c618b326e100ce8732  chrome-154.zip' \
    '9549b054ec4cf85f50f6a19d8c6fb79580312e71ebc4ec2cb217ec9af09dc12a  firefox-158.tar.xz' \
    '42f2c62a562316982ef5a796738c57602bf84a984f5c616e80bcff4627f78fff  firefox-157.tar.xz' \
    | sha256sum --check --strict \
 && mkdir -p /opt/browsers/chrome-155 /opt/browsers/chrome-154 /opt/browsers/firefox-158 /opt/browsers/firefox-157 \
 && unzip -q chrome-155.zip -d /opt/browsers/chrome-155 \
 && unzip -q chrome-154.zip -d /opt/browsers/chrome-154 \
 && tar -xJf firefox-158.tar.xz -C /opt/browsers/firefox-158 \
 && tar -xJf firefox-157.tar.xz -C /opt/browsers/firefox-157

FROM ${BASE}
LABEL org.opencontainers.image.title="vilicus-e22-browsers" \
      org.opencontainers.image.description="Spike E22 browser matrix (test image, not published)" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/Rwx-G/Vilicus"
COPY --from=fetch /opt/browsers /opt/browsers
# The test CA is generated by the server at start, so it is trusted at run time, never by
# ignoring certificate errors: Chrome reads the user NSS database, where the driver adds it
# with certutil; Firefox installs it from the enterprise policy below at startup.
RUN apt-get update && apt-get install --yes --no-install-recommends libnss3-tools
COPY firefox-policies.json /opt/browsers/firefox-158/firefox/distribution/policies.json
COPY firefox-policies.json /opt/browsers/firefox-157/firefox/distribution/policies.json
WORKDIR /driver
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY driver.mjs ./
# The Playwright image's unprivileged user.
USER pwuser
