* text=auto

# Files consumed inside Linux containers or by systemd must stay LF on a Windows checkout
*.sh text eol=lf
Dockerfile* text eol=lf
*.service text eol=lf
# Sourced by bash in the e2e/vm container: a CR would end every value it sets
e2e/vm/IMAGE.lock text eol=lf

# Vendored crates are checked against the checksums cargo vendor records: never convert them
vendor/** -text
# Spike vectors are compared byte for byte with recorded SHA-256 sums and shared across languages
spikes/*/vectors/** -text
